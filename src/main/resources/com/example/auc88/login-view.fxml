<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="380" prefWidth="420" spacing="20.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25" fx:controller="com.example.auc88.LoginController">
    <padding>
        <Insets bottom="40" left="40" right="40" top="40" />
    </padding>
    <Label style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #0066cc;" text="Auction88" />
    <Label style="-fx-font-size: 18px; -fx-text-fill: #555;" text="Sign in to continue" />

    <TextField fx:id="usernameField" promptText="Username or Email" scaleShape="false" />
    <PasswordField fx:id="passwordField" prefWidth="300" promptText="Password" scaleShape="false" />

    <Button onAction="#onLoginClicked" prefWidth="300" scaleShape="false" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-background-color: #0066cc; -fx-text-fill: white;" text="LOGIN" />

    <HBox alignment="CENTER" spacing="10">
        <Label text="Don't have an account?" />
        <Hyperlink onAction="#onSwitchToSignup" text="Create one now" />
    </HBox>

    <Label fx:id="statusLabel" style="-fx-text-fill: red; -fx-font-size: 14px;" />
    <Label prefHeight="18.0" prefWidth="372.0" style="-fx-font-size: 12px; -fx-text-fill: #888;" text="Demo: demo/demo (Bidder) • seller/123 (Seller) • admin/123 (Admin)" />
</VBox>
